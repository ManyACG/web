{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": false,
  "trailingComma": "none",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "pnpm-lock.yaml",
    "LICENSE.md",
    "tsconfig.json",
    "tsconfig.*.json",
    ".nuxt/**",
    ".output/**"
  ]
}
